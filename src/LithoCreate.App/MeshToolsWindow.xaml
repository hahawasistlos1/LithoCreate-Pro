<Window x:Class="LithoCreate.App.MeshToolsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:LithoCreate.App.Controls" Title="Erweiterungen &amp; STL · LithoCreate Pro" Width="1120" Height="760" MinWidth="800" MinHeight="500" Background="#06111C" Foreground="#DCEAF4" Icon="/LithoCreate Pro;component/Assets/LithoCreate.ico" WindowStartupLocation="CenterOwner">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock x:Name="ToolHeading" Text="Modelle prüfen. Formen erweitern." FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="ToolDescription" Text="STL-Dateien werden als Millimeter / Z nach oben eingelesen. Module erzeugen ein neues Fotomodell mit den aktuellen Bild- und Maßeinstellungen." TextWrapping="Wrap" Margin="0,7,0,12" Foreground="#9EB9CB"/><WrapPanel><Button x:Name="ImportButton" Content="STL öffnen" Click="ImportStl"/><Button x:Name="PluginButton" Content="Formmodul laden …" Click="LoadPlugin"/><Button x:Name="PhotoButton" Content="Aktuelles Projektmodell prüfen" Click="UseProject"/><Button x:Name="KitButton" Content="PETG-Probedruckpaket" Click="SaveKit"/></WrapPanel></StackPanel>
  <Grid Grid.Row="1" Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="265"/></Grid.ColumnDefinitions><Border BorderBrush="#23485C" BorderThickness="1" CornerRadius="10"><controls:ModelViewport x:Name="Preview"/></Border>
   <ScrollViewer Grid.Column="1" Margin="15,0,0,0" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Geometrieprüfung" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="Info" Text="STL-Datei öffnen oder ein Formmodul auswählen." TextWrapping="Wrap" Margin="0,12"/><TextBlock Text="Bei offenem oder fehlerhaftem Netz bleibt der Export gesperrt. Selbstüberschneidungen und weitere Fehler können eine zusätzliche CAD-/Slicerprüfung erfordern." TextWrapping="Wrap" FontSize="11" Foreground="#9EB9CB" Margin="0,0,0,12"/>
    <Button x:Name="ExportButton" Content="Geprüftes Modell speichern" Click="SaveModel" IsEnabled="False" Background="#12813B"/><Button x:Name="BambuButton" Content="In Bambu Studio öffnen" Click="OpenBambu" IsEnabled="False"/><TextBlock Text="Die Slicer-Übergabe speichert eine geprüfte Modelldatei und öffnet sie lokal. Drucker, PETG, Stützen und Druckvorschau in Bambu Studio kontrollieren. Es wird kein Druckauftrag gestartet." TextWrapping="Wrap" FontSize="11" Foreground="#9EB9CB" Margin="0,6,0,16"/>
    <Expander x:Name="LightInsertPanel" Header="Lichteinsätze mit Kabelausgang" Foreground="#DCEAF4" Margin="0,0,0,16">
     <StackPanel Margin="0,8,0,0">
      <TextBlock x:Name="InsertShapeLabel" TextWrapping="Wrap" FontWeight="SemiBold"/>
      <ComboBox x:Name="InsertChoice" DisplayMemberPath="Name" SelectionChanged="InsertChanged" AutomationProperties.Name="Lichteinsatz"/>
      <TextBlock x:Name="InsertPlacement" TextWrapping="Wrap" FontSize="11" Foreground="#9EB9CB" Margin="0,4,0,7"/>
      <StackPanel x:Name="SocketInsertFields">
       <CheckBox x:Name="InsertRound" Content="Runde Platte" Checked="InsertOutlineChanged" Unchecked="InsertOutlineChanged"/>
       <TextBlock x:Name="InsertWidthLabel" Text="Außen-Ø · mm"/>
       <TextBox x:Name="InsertWidth" TextChanged="ParametersChanged" AutomationProperties.Name="Außenmaß des Einsatzes"/>
      </StackPanel>
      <StackPanel x:Name="InsertLengthFields">
       <TextBlock Text="Länge · mm"/><TextBox x:Name="InsertLength" TextChanged="ParametersChanged" AutomationProperties.Name="Länge des Einsatzes"/>
      </StackPanel>
      <TextBlock x:Name="InsertOpeningLabel" Text="Freie Fassungsöffnung · mm"/>
      <TextBox x:Name="InsertOpening" TextChanged="ParametersChanged" AutomationProperties.Name="Freie Öffnung oder Bandbreite"/>
      <TextBlock Text="Stärke · mm"/><TextBox x:Name="InsertThickness" TextChanged="ParametersChanged" AutomationProperties.Name="Stärke des Einsatzes"/>
      <TextBlock Text="Kabelausgang · Breite in mm"/><TextBox x:Name="InsertCable" TextChanged="ParametersChanged" AutomationProperties.Name="Breite des Kabelausgangs"/>
      <Button x:Name="BuildInsertButton" Content="Lichteinsatz berechnen" Click="BuildInsert" Margin="0,7,0,4"/>
      <TextBlock Text="Passive Halter für fertige LED-Fassungen oder LED-Band. Öffnung, Kabel und Passung nachmessen. Für Glüh- und Halogenlampen hitzebeständige Originalteile verwenden." TextWrapping="Wrap" FontSize="11" Foreground="#E8BC7B"/>
     </StackPanel>
    </Expander>
    <TextBlock Text="Licht &amp; Halterungen" FontSize="16" FontWeight="SemiBold"/><ComboBox x:Name="MountChoice" SelectionChanged="MountChanged" Margin="0,8"/><TextBlock x:Name="MeasureALabel" Text="Maß 1 · mm"/><TextBox x:Name="MeasureA" TextChanged="ParametersChanged" Text="8,5"/><TextBlock x:Name="MeasureBLabel" Text="Länge · mm"/><TextBox x:Name="MeasureB" TextChanged="ParametersChanged" Text="50"/><TextBlock Text="Wand-/Plattenstärke · mm"/><TextBox x:Name="MeasureT" TextChanged="ParametersChanged" Text="2"/><TextBlock Text="Bohrungen für Montageplatte / Fotomodul · X Y Ø je Zeile, mm. X ab Mitte, Y ab Unterkante." FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBox x:Name="PlateHoles" AcceptsReturn="True" MinHeight="65" TextChanged="ParametersChanged" Text="-15 20 4&#10;15 20 4"/>
    <Button x:Name="MountButton" Content="Halterung berechnen" Click="BuildMount"/><TextBlock Text="Passive Bauteile nach Maß, keine elektrische Fassung. E14/E27-Durchlass am gekauften Fassungsmodell prüfen; Gewinde werden nicht gedruckt. Für PETG keine Freigabe für Glüh-/Halogenlampen. LED-Leuchtmittel, Abstände und Temperatur praktisch prüfen." TextWrapping="Wrap" FontSize="11" Foreground="#E8BC7B" Margin="0,5,0,16"/>
    <TextBlock Text="Ansicht" FontWeight="SemiBold"/><WrapPanel><Button Content="Vorn" Click="Front"/><Button Content="Oben" Click="ViewTop"/><Button Content="Material / Licht" Click="ToggleLight"/></WrapPanel>
    <TextBlock Text="Fremde STL-Dateien sind hier Prüfmodelle. Ein Foto wird nicht automatisch auf eine beliebige STL-Oberfläche projiziert. Ein Formmodul muss seine Fotoabbildung selbst implementieren." TextWrapping="Wrap" FontSize="11" Foreground="#9EB9CB" Margin="0,15,0,0"/>
   </StackPanel></ScrollViewer>
  </Grid><DockPanel Grid.Row="2" LastChildFill="True"><Button DockPanel.Dock="Right" x:Name="CancelButton" Content="Berechnung abbrechen" Click="Cancel" IsEnabled="False" Margin="12,0,0,0"/><TextBlock x:Name="Status" Text="Bereit · lokal und offline" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" Foreground="#9EB9CB"/></DockPanel>
 </Grid>
</Window>
