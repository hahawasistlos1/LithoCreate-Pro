    <AssemblyName>LithoCreate Pro</AssemblyName><Version>1.21.2</Version><ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/LithoCreate.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../LithoCreate.Core/LithoCreate.Core.csproj" /></ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="LithoCreate.Tests" /></ItemGroup>
